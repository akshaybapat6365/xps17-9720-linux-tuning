-- XPS 17 4K panel: preserve the tuned fractional scale. Do not set GDK_SCALE;
-- GTK, Qt, Chromium, and Electron should follow Wayland fractional scaling.
hl.env("QT_AUTO_SCREEN_SCALE_FACTOR", "1")
-- The internal UHD+ Sharp 0x1517 panel keeps its tuned 1.6x scale and applies
-- an EDID-verified D65 wide-gamut ICC clamp (no VCGT) so sRGB UI colors stay
-- accurate instead of oversaturating on the AdobeRGB/P3-class gamut.
-- bitdepth = 8 stays active live for zero-flicker KMS safety; uncomment
-- bitdepth = 10 during a gated display trial if 10-bpc scanout is desired.
local shp_icc = (os.getenv("HOME") or "") .. "/.local/share/icc/SHP1517-d65.icc"
hl.monitor({
  output = "eDP-1",
  mode = "3840x2400@59.994",
  position = "auto",
  scale = 1.6,
  bitdepth = 8,
  -- bitdepth = 10, -- Gated 10-bpc trial option (triggers KMS modeset on switch)
  cm = "auto",
  icc = shp_icc,
})
-- External displays default to native scale instead of inheriting the laptop's
-- 1.6 factor; add an explicit rule later only when a monitor needs HiDPI.
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1.0, cm = "auto" })
