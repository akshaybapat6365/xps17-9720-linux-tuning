# Dell XPS 17 9720 battery health preservation (BAT0).
# Enforce Custom 55-80% charge cap across reboots unless travel override is active.
# Guards avoid needless Dell SMBIOS SMI writes on routine battery change events.
ACTION=="add|change", SUBSYSTEM=="power_supply", KERNEL=="BAT0", TEST=="charge_types", TEST!="/run/omarchy-battery-cap.travel", ATTR{charge_types}!="*[[]Custom[]]*", ATTR{charge_types}="Custom"
ACTION=="add|change", SUBSYSTEM=="power_supply", KERNEL=="BAT0", TEST=="charge_control_start_threshold", TEST!="/run/omarchy-battery-cap.travel", ATTR{charge_control_start_threshold}!="55", ATTR{charge_control_start_threshold}="55"
ACTION=="add|change", SUBSYSTEM=="power_supply", KERNEL=="BAT0", TEST=="charge_control_end_threshold", TEST!="/run/omarchy-battery-cap.travel", ATTR{charge_control_end_threshold}!="80", ATTR{charge_control_end_threshold}="80"
