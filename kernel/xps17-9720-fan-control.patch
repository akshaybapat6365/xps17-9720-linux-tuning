+	/*
+	 * LOCAL PATCH: devm actions run in reverse order on unbind. Registered
+	 * here, after the data it uses and before the hwmon and cooling devices,
+	 * the hand-back runs once nothing can write pwm1_enable any more.
+	 */
+	if (xps17_fan_ctrl_active) {
+		ret = devm_add_action_or_reset(&wdev->dev, dell_smm_xps17_unbind,
+					       dev_get_drvdata(&wdev->dev));
+		if (ret)
+			return ret;
+	}
+
 	return dell_smm_init_hwmon(&wdev->dev);
 }
 
