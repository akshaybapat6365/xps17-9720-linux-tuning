+/*
+ * LOCAL PATCH (XPS 17 9720): no command pair for switching BIOS fan control
+ * is published for this model, so it is chosen at load time and defaults to
+ * none, which is exactly the upstream behaviour.
+ */
+static uint xps17_fan_ctrl;
+module_param(xps17_fan_ctrl, uint, 0444);
+MODULE_PARM_DESC(xps17_fan_ctrl, "XPS 17 9720 only: BIOS fan control command pair (0 = none, as upstream; 1 = 0x30a3/0x31a3; 2 = 0x34a3/0x35a3)");
+
+static bool xps17_fan_ctrl_active;
+
 static bool disallow_fan_type_call, disallow_fan_support;
 
 static unsigned int manual_fan, auto_fan;
@@ -1658,6 +1669,75 @@
 	{ }
 };
 
+/* LOCAL PATCH: the one model this build adds, gated by xps17_fan_ctrl. */
+static const struct dmi_system_id i8k_xps17_9720_dmi_table[] __initconst = {
+	{
+		.ident = "Dell XPS 17 9720",
+		.matches = {
+			DMI_EXACT_MATCH(DMI_SYS_VENDOR, "Dell Inc."),
+			DMI_EXACT_MATCH(DMI_PRODUCT_NAME, "XPS 17 9720"),
+		},
+	},
+	{ }
+};
+
+/*
+ * LOCAL PATCH: give fan control back to the BIOS on unbind (rmmod), before
+ * every system sleep, again on every resume, and at power-off, so none of
+ * them can leave the fans in manual mode. Sending "BIOS on" while the BIOS
+ * already has the fans changes nothing, so every hook is safe to repeat.
+ * Active only when the XPS 17 9720 pair is. A failure is logged with the
+ * fixed text "could not return fan control", which the scripts search for.
+ */
+static void dell_smm_xps17_restore_auto(struct dell_smm_data *data, const char *when)
+{
+	int err;
+
+	mutex_lock(&data->i8k_mutex);
+	err = i8k_enable_fan_auto_mode(data, true);
+	mutex_unlock(&data->i8k_mutex);
+
+	if (err < 0)
+		pr_warn("XPS 17 9720: could not return fan control to the BIOS on %s (%d)\n",
+			when, err);
+}
+
+static void dell_smm_xps17_unbind(void *param)
+{
+	dell_smm_xps17_restore_auto(param, "unbind");
+}
+
+static int dell_smm_xps17_suspend(struct device *dev)
+{
+	struct dell_smm_data *data = dev_get_drvdata(dev);
+
+	if (xps17_fan_ctrl_active && data)
+		dell_smm_xps17_restore_auto(data, "suspend");
+
+	return 0;
+}
+
+static int dell_smm_xps17_resume(struct device *dev)
+{
+	struct dell_smm_data *data = dev_get_drvdata(dev);
+
+	if (xps17_fan_ctrl_active && data)
+		dell_smm_xps17_restore_auto(data, "resume");
+
+	return 0;	/* never fail a resume over the fans */
+}
+
+static DEFINE_SIMPLE_DEV_PM_OPS(dell_smm_xps17_pm_ops, dell_smm_xps17_suspend,
+				dell_smm_xps17_resume);
+
+static void dell_smm_wmi_shutdown(struct wmi_device *wdev)
+{
+	struct dell_smm_data *data = dev_get_drvdata(&wdev->dev);
+
+	if (xps17_fan_ctrl_active && data)
+		dell_smm_xps17_restore_auto(data, "shutdown");
+}
+
 /*
  * Legacy SMM backend driver.
  */
@@ -1709,6 +1789,18 @@
 	if (ret < 0)
